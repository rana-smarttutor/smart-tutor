MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/smartiq?retryWrites=true&w=majority&appName=smartiq
MONGODB_DB=smartiq
MONGODB_BOOTSTRAP_KEY=change-me

SESSION_SECRET=replace_with_a_random_64_char_secret

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Payment processing (optional – leave default test keys to enable sandbox)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret

# Vercel Blob (for Digital Library)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
